{
  "name": "favorite-matrix-client",
  "version": "1.3.3",
  "private": true,
  "description": "Select your favorite Matrix web client for matrix.to",
  "license": "MPL-2.0",
  "repository": "github:freaktechnik/favorite-matrix-client",
  "author": "Martin Giger (https://humanoids.be)",
  "type": "module",
  "main": "./rewrite.js",
  "engines": {
    "node": ">= 22"
  },
  "scripts": {
    "test": "npm run lint",
    "lint": "npm run lint:js && npm run lint:webext",
    "lint:js": "eslint .",
    "lint:webext": "web-ext lint",
    "build": "web-ext build"
  },
  "devDependencies": {
    "@freaktechnik/eslint-config-extension": "^14.1.0",
    "eslint": "^10.14.0",
    "web-ext": "^10.8.0"
  },
  "browserslist": [
    "firefox >= 109"
  ],
  "webExt": {
    "ignoreFiles": [
      "package.json",
      "package-lock.json",
      "README.md"
    ]
  }
}
